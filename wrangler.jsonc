{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "fersil-vc-website-cloudflare",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "fersil-vc-website-cloudflare"
		}
	],
	"vars": {
		"SITE_COMING_SOON": "1",
		"ADMIN_OPEN_ACCESS": "0",
		"ADMIN_EMAIL": "admin@fersil.vc",
		"ADMIN_2FA_ENABLED": "1",
		"GMAIL_SENDER_EMAIL": "admin@fersil.vc",
		"NEXT_PUBLIC_SITE_URL": "https://fersil.vc"
	},
	"ratelimits": [
		{
			"name": "ACCESS_CODE_RATE_LIMITER",
			"namespace_id": "19701",
			"simple": { "limit": 3, "period": 60 }
		},
		{
			"name": "ADMIN_LOGIN_RATE_LIMITER",
			"namespace_id": "19702",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"r2_buckets": [
		{
			"binding": "FERSIL_CONTENT",
			"bucket_name": "fersil-vc-content"
		},
		{
			"binding": "FERSIL_MEDIA",
			"bucket_name": "fersil-vc-media"
		},
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "fersil-vc-inc-cache"
		}
	]
}
