NEXT_PUBLIC_SITE_URL=https://fersil.vc
SITE_COMING_SOON=1
DEVELOPER_ACCESS_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=admin@fersil.vc
SMTP_FROM_EMAIL=FerSil VC <admin@fersil.vc>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Optional fallback if you choose SMTP password auth instead of OAuth
SMTP_PASS=

# Optional local/admin settings
ADMIN_OPEN_ACCESS=0
NEXT_PUBLIC_ADMIN_2FA_ENABLED=0
ADMIN_TOTP_SECRET=

# Optional Cloudflare binding overrides if you rename the default bindings
# CLOUDFLARE_CONTENT_BUCKET_BINDING=FERSIL_CONTENT
# CLOUDFLARE_MEDIA_BUCKET_BINDING=FERSIL_MEDIA
